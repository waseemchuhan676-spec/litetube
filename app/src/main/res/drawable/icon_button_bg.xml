<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon-button background (v1.6.0): mic and gear buttons next to
     the search pill. Transparent by default (no box, like the reference's
     top-right icons); a light-grey circle on focus/press so D-Pad and
     touch users still get feedback. No red. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#EDEDED" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E0E0E0" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
