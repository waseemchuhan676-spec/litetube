<?xml version="1.0" encoding="utf-8"?>
<!-- Light-grey box shown behind a video thumbnail while it loads, and in
     place of it when the video has no thumbnail or the fetch failed
     (v1.4.0). The thumbnail ImageView keeps this as its background, so
     a failed load never leaves a broken image — just the grey box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E0E0E0" />
    <corners android:radius="6dp" />
</shape>
