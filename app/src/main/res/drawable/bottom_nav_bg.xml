<?xml version="1.0" encoding="utf-8"?>
<!-- Floating bottom navigation bar (v1.6.0, VidMate reference): a white
     pill with 24dp corners, lifted off the background with elevation
     (set in the layout). The five tabs sit inside it with no boxes of
     their own; the selected tab turns red in code. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lt_surface" />
    <corners android:radius="24dp" />
</shape>
