<?xml version="1.0" encoding="utf-8"?>
<!-- Selected category chip (v1.4.0): solid brand-red pill. The focused
     state adds a darker red border so a D-Pad user can still see which
     chip has focus when it is already the selected one. Unselected chips
     use @drawable/focus_border (white card + grey border, red on focus);
     the background is swapped in code when the selection changes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lt_red" />
            <stroke
                android:width="3dp"
                android:color="@color/lt_red_dark" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lt_red" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
