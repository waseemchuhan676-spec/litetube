<?xml version="1.0" encoding="utf-8"?>
<!-- Unselected category chip (v1.6.0, VidMate reference): white pill
     with a thin light-grey border and dark text (set in code). The
     focused state fills light grey with a darker border so D-Pad focus
     is always visible. Paired with @drawable/chip_selected (black). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#EEEEEE" />
            <stroke
                android:width="2dp"
                android:color="@color/lt_text_secondary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EEEEEE" />
            <stroke
                android:width="1dp"
                android:color="@color/lt_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lt_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/lt_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
