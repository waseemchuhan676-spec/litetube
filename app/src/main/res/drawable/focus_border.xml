<?xml version="1.0" encoding="utf-8"?>
<!--
  High-contrast focus indicator for TV remote navigation.
  Focused state: bright yellow border + slightly lighter background, so the
  focused control is unmistakable on a TV viewed from across the room.
  Default state: thin dark-grey border, transparent background.
  Pressed state: cyan border, so touch users get feedback too.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E2A36" />
            <stroke
                android:width="3dp"
                android:color="#FFEB3B" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#12303A" />
            <stroke
                android:width="2dp"
                android:color="#00E5FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#3A4A5A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
