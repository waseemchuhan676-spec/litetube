<?xml version="1.0" encoding="utf-8"?>
<!--
  High-contrast focus indicator for TV remote navigation, light theme
  (v1.4.0). The old dark version (yellow border on dark fill) would be
  unreadable on the new white background, so:
  Focused state: brand-red border + very light red fill, unmistakable on
  a TV viewed from across the room and on a phone.
  Default state: white fill + thin light-grey border, so rows read as
  white cards on the light-grey background with subtle separation.
  Pressed state: light-grey fill + red border, so touch users get
  feedback too.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lt_focus_fill" />
            <stroke
                android:width="3dp"
                android:color="@color/lt_red" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EEEEEE" />
            <stroke
                android:width="2dp"
                android:color="@color/lt_red" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lt_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/lt_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
