<?xml version="1.0" encoding="utf-8"?>
<!-- Player bottom-bar scrim (v1.9.0): a dark gradient, transparent at
     the top fading to near-black at the bottom, so the white controls
     read over any video (YouTube/VidMate style). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#CC000000"
        android:startColor="#00000000"
        android:type="linear" />
</shape>
