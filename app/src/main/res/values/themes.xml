<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light professional theme (v1.4.0, VidMate-style): no action bar (the
         layout provides its own header row), white/light-grey background,
         near-black primary text, grey secondary text, brand-red accent.
         The old dark theme (#0B0F14 background, white text) is gone. -->
    <style name="Theme.LiteTube" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/lt_background</item>
        <item name="android:textColorPrimary">@color/lt_text_primary</item>
        <item name="android:textColorSecondary">@color/lt_text_secondary</item>
        <item name="colorPrimary">@color/lt_red</item>
        <item name="colorPrimaryDark">@color/lt_red_dark</item>
        <item name="colorAccent">@color/lt_red</item>
    </style>
</resources>
