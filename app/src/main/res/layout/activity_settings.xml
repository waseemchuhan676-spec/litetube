<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings screen (v1.5.0): Updates / Downloads / About, in the light
  theme. A ScrollView so the whole screen fits on a small TV or phone
  (nothing is ever cut off). D-Pad rules, same as the main screen:
  only actionable controls are focusable (back button, switches,
  buttons, spinners); labels and values are focusable="false" so the
  remote can never get trapped. nextFocusDown chains the order
  top-to-bottom; the ScrollView scrolls the focused control into view.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lt_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: back + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/focus_border"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/autoUpdateSwitch"
                android:padding="12dp"
                android:text="@string/settings_back"
                android:textColor="@color/lt_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:focusable="false"
                android:text="@string/settings_title"
                android:textColor="@color/lt_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Updates -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:focusable="false"
            android:text="@string/settings_section_updates"
            android:textColor="@color/lt_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/focus_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:text="@string/settings_auto_update"
                    android:textColor="@color/lt_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:paddingTop="2dp"
                    android:text="@string/settings_auto_update_desc"
                    android:textColor="@color/lt_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoUpdateSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/checkNowButton"
                android:nextFocusUp="@+id/settingsBack" />
        </LinearLayout>

        <Button
            android:id="@+id/checkNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/focus_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/defaultQualitySpinner"
            android:nextFocusUp="@+id/autoUpdateSwitch"
            android:padding="14dp"
            android:text="@string/settings_check_now"
            android:textColor="@color/lt_red"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/checkStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:paddingTop="6dp"
            android:textColor="@color/lt_text_secondary"
            android:textSize="14sp" />

        <!-- Version info (display-only rows) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/settings_version"
                android:textColor="@color/lt_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/versionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textColor="@color/lt_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/settings_package"
                android:textColor="@color/lt_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/packageValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textColor="@color/lt_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/settings_extractor"
                android:textColor="@color/lt_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/extractorValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textColor="@color/lt_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/settings_channel"
                android:textColor="@color/lt_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/channelValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textColor="@color/lt_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Downloads -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:focusable="false"
            android:text="@string/settings_section_downloads"
            android:textColor="@color/lt_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:text="@string/settings_default_quality"
            android:textColor="@color/lt_text_primary"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/defaultQualitySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/focus_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/changeFolderButton"
            android:nextFocusUp="@+id/checkNowButton"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:text="@string/settings_download_folder"
            android:textColor="@color/lt_text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/folderPathText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:textColor="@color/lt_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/changeFolderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/focus_border"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/wifiOnlySwitch"
                android:nextFocusUp="@+id/defaultQualitySpinner"
                android:padding="12dp"
                android:text="@string/settings_change_folder"
                android:textColor="@color/lt_red"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/focus_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:text="@string/settings_wifi_only"
                    android:textColor="@color/lt_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:paddingTop="2dp"
                    android:text="@string/settings_wifi_only_desc"
                    android:textColor="@color/lt_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/wifiOnlySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/mobileLimitSpinner"
                android:nextFocusUp="@+id/changeFolderButton" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:text="@string/settings_mobile_limit"
            android:textColor="@color/lt_text_primary"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/mobileLimitSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/focus_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/wifiLimitSpinner"
            android:nextFocusUp="@+id/wifiOnlySwitch"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:text="@string/settings_wifi_limit"
            android:textColor="@color/lt_text_primary"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/wifiLimitSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/focus_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/websiteButton"
            android:nextFocusUp="@+id/mobileLimitSpinner"
            android:padding="10dp" />

        <!-- About -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:focusable="false"
            android:text="@string/settings_section_about"
            android:textColor="@color/lt_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:text="@string/settings_about_text"
            android:textColor="@color/lt_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/websiteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/focus_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/wifiLimitSpinner"
            android:padding="14dp"
            android:text="@string/settings_website"
            android:textColor="@color/lt_red"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
