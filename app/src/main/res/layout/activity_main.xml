<?xml version="1.0" encoding="utf-8"?>
<!--
  Main screen. D-Pad rules applied here:
  - Only actionable controls are focusable: search field, mic button,
    search button, results list rows, quality spinner, download button.
  - PlayerView and both text views are focusable="false" so D-Pad focus can
    NEVER get trapped inside a non-actionable element.
  - nextFocusDown chains the focus order top-to-bottom so a remote user
    always has an escape route.
  - The mic button is GONE on devices with no speech recognizer
    (MainActivity hides it); GONE views are skipped by D-Pad focus search,
    so the chain still works there.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Search row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/focus_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="textUri"
            android:nextFocusDown="@+id/clearHistory"
            android:nextFocusRight="@+id/voiceButton"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A9BA8"
            android:textSize="16sp" />

        <!-- Voice search (YouTube-style mic in the search bar). Tapping it
             asks for the mic permission, then listens and searches what was
             heard. Hidden at runtime where no recognizer exists. -->
        <ImageButton
            android:id="@+id/voiceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/focus_border"
            android:contentDescription="@string/voice_search"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/clearHistory"
            android:nextFocusLeft="@+id/searchInput"
            android:nextFocusRight="@+id/searchButton"
            android:nextFocusUp="@+id/searchInput"
            android:padding="12dp"
            android:src="@drawable/ic_mic" />

        <Button
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/focus_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/resultsList"
            android:nextFocusLeft="@+id/voiceButton"
            android:nextFocusUp="@+id/searchInput"
            android:padding="12dp"
            android:text="@string/search"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Suggestions + recent searches, shown under the search bar while
         typing or while the field is focused and empty. GONE otherwise.
         Focus chain: search field -> Clear (history mode only) ->
         suggestions list -> search button. GONE views are skipped by
         D-Pad focus search, so the chain still works when parts hide. -->
    <LinearLayout
        android:id="@+id/suggestionsHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/suggestionsHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#8A9BA8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/clearHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/focus_border"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/suggestionsList"
            android:nextFocusUp="@+id/searchInput"
            android:padding="6dp"
            android:text="@string/clear_history"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestionsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@+id/searchButton"
        android:nextFocusUp="@+id/searchInput"
        android:visibility="gone" />

    <!-- Loading / status line (not focusable). -->
    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:paddingTop="4dp"
        android:textColor="#8A9BA8"
        android:textSize="14sp" />

    <!-- Search results. Each row is focusable; the list itself is the
         D-Pad step between the search button and the quality spinner. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@+id/relatedList"
        android:nextFocusUp="@+id/searchButton" />

    <!-- Player. Deliberately NOT focusable: the remote must never land here,
         playback is controlled through the buttons below it. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:controller_layout_id="@layout/player_controls"
        app:use_controller="true" />

    <!-- Title + metadata (not focusable). -->
    <TextView
        android:id="@+id/videoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:paddingTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/videoMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:textColor="#8A9BA8"
        android:textSize="14sp" />

    <!-- Related videos for the loaded video. GONE until a video with
         related items loads; rows reuse the results adapter and focus
         rules, so D-Pad users move results -> related -> quality. -->
    <TextView
        android:id="@+id/relatedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:paddingTop="8dp"
        android:text="@string/related_header"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/relatedList"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="4dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@+id/qualitySpinner"
        android:nextFocusUp="@+id/resultsList"
        android:visibility="gone" />

    <!-- Quality + download row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/qualitySpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/focus_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/downloadButton"
            android:nextFocusRight="@+id/downloadButton"
            android:nextFocusUp="@+id/relatedList"
            android:padding="8dp" />

        <Button
            android:id="@+id/downloadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/focus_border"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/qualitySpinner"
            android:nextFocusUp="@+id/relatedList"
            android:padding="14dp"
            android:text="@string/download_to_gallery"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
