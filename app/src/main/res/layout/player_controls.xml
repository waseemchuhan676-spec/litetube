<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal Media3 controller (v1.7.0): play/pause toggle + a big red
     download arrow. The PlayerView shows this bar over the video when
     playback starts (and when the user taps the video), so the download
     arrow is right there, impossible to miss. Play/pause icons are DARK
     now — the old white icons on the white button background rendered
     as two blank white boxes over every playing video. The download
     arrow runs the same download as the popup's Download button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageButton
        android:id="@id/exo_play"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/focus_border"
        android:contentDescription="@string/play_pause"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@id/exo_pause"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/focus_border"
        android:contentDescription="@string/play_pause"
        android:src="@drawable/ic_pause" />

    <!-- Download arrow: red circle + white arrow, the most visible
         control on the playing video. -->
    <ImageButton
        android:id="@+id/playerDownloadButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/download_arrow_bg"
        android:contentDescription="@string/download_video"
        android:padding="12dp"
        android:src="@drawable/ic_download_arrow" />

</LinearLayout>
