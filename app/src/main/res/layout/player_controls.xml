<?xml version="1.0" encoding="utf-8"?>
<!-- Natural player controls (v1.9.0, YouTube/VidMate style): the whole
     controller is a bottom bar over the video — nothing big floats on
     top of the picture anymore. Single tap on the video toggles
     play/pause (see MainActivity's gesture detector); double-tap left
     / right seeks -10s / +10s and flashes the pill below; the bar
     holds play/pause, current time, seek bar, duration, the VidMate
     red-circle download arrow and Share. The standard Media3 ids
     (exo_play, exo_pause, exo_position, exo_progress, exo_duration)
     are wired by PlayerView itself; the download/share buttons are
     wired in MainActivity. The bar sits on a dark gradient so the
     white icons read over any video. D-Pad: the bar buttons are the
     only focusable controls here, same as before. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Double-tap seek feedback: shown for ~700ms by MainActivity,
         hidden otherwise. Left pill = -10s, right pill = +10s. -->
    <TextView
        android:id="@+id/seekBackLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="56dp"
        android:background="@drawable/seek_feedback_bg"
        android:paddingBottom="8dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:text="-10s"
        android:textColor="@color/lt_surface"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seekForwardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="56dp"
        android:background="@drawable/seek_feedback_bg"
        android:paddingBottom="8dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:text="+10s"
        android:textColor="@color/lt_surface"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom control bar: play/pause, time, seek bar, duration,
         download, share. Anchored to the bottom of the video. -->
    <LinearLayout
        android:id="@+id/playerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@id/exo_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/play_pause"
            android:src="@drawable/ic_play"
            android:tint="@color/lt_surface" />

        <ImageButton
            android:id="@id/exo_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/play_pause"
            android:src="@drawable/ic_pause"
            android:tint="@color/lt_surface" />

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/lt_surface"
            android:textSize="12sp" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/lt_surface"
            android:textSize="12sp" />

        <!-- Download arrow: red circle + white arrow (VidMate style),
             the most visible control in the bar. Same download as the
             popup button; uses the effective quality. -->
        <ImageButton
            android:id="@+id/playerDownloadButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/download_arrow_bg"
            android:contentDescription="@string/download_video"
            android:padding="8dp"
            android:src="@drawable/ic_download_arrow" />

        <ImageButton
            android:id="@+id/playerShareButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/share_video"
            android:padding="8dp"
            android:src="@drawable/ic_share" />
    </LinearLayout>

</FrameLayout>
