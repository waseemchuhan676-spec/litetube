<?xml version="1.0" encoding="utf-8"?>
<!-- Search result / home-feed / related row. The whole row is one focusable
     unit for D-Pad; the three-dots button at the right is a second focusable
     stop (VidMate-style download menu). Focus: row nextFocusRight -> the
     ⋮ button (resolved inside this row's own subtree, so duplicate ids
     across rows are safe); the button hands DPAD_LEFT back to the row in
     code (SearchResultsAdapter), and UP/DOWN fall through to the list's
     normal geometric row-to-row movement. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resultRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/focus_border"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusRight="@+id/rowMenuButton"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:paddingTop="2dp"
            android:textColor="#8A9BA8"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Three-dots menu (Download). Focusable so D-Pad users can reach it
         from the row with RIGHT; tapping it opens a PopupMenu. -->
    <ImageButton
        android:id="@+id/rowMenuButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:background="@drawable/focus_border"
        android:contentDescription="@string/download_options"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert" />

</LinearLayout>
