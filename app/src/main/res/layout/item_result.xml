<?xml version="1.0" encoding="utf-8"?>
<!-- Video card (v1.6.0, VidMate reference): a vertical card, NOT a
     horizontal row. Large 16:9 thumbnail on top (190dp, rounded top
     corners, clipped to the card outline), title + channel/meta below,
     and a download icon + vertical-dots button on the meta line. The
     whole card is one focusable unit for D-Pad; the download icon and
     the dots button are two extra focus stops (see
     SearchResultsAdapter): card RIGHT to download icon, RIGHT to dots
     button; LEFT walks back the same way.
     The thumbnail is never focusable. The card background is
     @drawable/card_bg (white + thin border, red border on focus). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resultRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusRight="@+id/rowDownloadButton"
    android:orientation="vertical">

    <!-- Large 16:9 thumbnail. Fixed 190dp height with centerCrop: on a
         phone this is ~1.8:1, i.e. 16:9 for the card width. Rounded top
         corners via thumb_rounded + clipToOutline (API 21+); the
         placeholder grey shows while it loads or when the video has no
         thumbnail. -->
    <ImageView
        android:id="@+id/resultThumbnail"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/thumb_rounded"
        android:clipToOutline="true"
        android:contentDescription="@string/thumbnail"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:scaleType="centerCrop" />

    <!-- Title + meta, with the download icon and ⋮ on the same line. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="2"
                android:textColor="@color/lt_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:textColor="@color/lt_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Per-card download (VidMate reference): downloads this video
             straight away, same flow as the popup and the ⋮ menu. -->
        <ImageButton
            android:id="@+id/rowDownloadButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/focus_border"
            android:contentDescription="@string/download"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="8dp"
            android:src="@drawable/ic_download" />

        <!-- Three-dots menu (Download). Focusable so D-Pad users can
             reach it from the download icon with RIGHT; tapping it
             opens a PopupMenu. -->
        <ImageButton
            android:id="@+id/rowMenuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/focus_border"
            android:contentDescription="@string/download_options"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert" />

    </LinearLayout>

</LinearLayout>
