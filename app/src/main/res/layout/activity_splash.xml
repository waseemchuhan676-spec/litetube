<?xml version="1.0" encoding="utf-8"?>
<!-- Splash / starting screen (v1.10.0, YouTube/VidMate style): full-screen
     dark navy, the LittleTube logo + name centered, a small loading
     spinner at the bottom. Shows for ~1.5s while the app starts, then
     SplashActivity hands over to MainActivity. Nothing here is
     focusable, so D-Pad users can never get stuck on it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lt_navy">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="84dp"
            android:contentDescription="@string/app_name"
            android:focusable="false"
            android:src="@drawable/ic_littletube_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:paddingTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/lt_surface"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:focusable="false"
        android:indeterminate="true"
        android:indeterminateTint="@color/lt_surface" />

</FrameLayout>
